                },
                "name": "vllm",
                "dtype": "bfloat16",
                "load_format": "safetensors",
                "gpu_memory_utilization": 0.8,
                "engine_kwargs": {
                    "vllm": {
                        "generation_config": "vllm",
                        "enable_auto_tool_choice": true,
                        "tool_call_parser": "hermes",
                        "max_lora_rank": 16
                    }
                }
            },
            "actor": {
                "ppo_mini_batch_size": 20,
                "ppo_micro_batch_size_per_gpu": 10,
                "optim": {
                    "lr": 5e-6,
                    "betas": [
                        0.9,
                        0.99
                    ],
                    "weight_decay": 0.1,
                    "clip_grad": 0.1
                },
                "use_kl_loss": false,
                "kl_loss_coef": 0.0,
