{
    "train_size": null,
    "val_size": 500,
    "n_runners": 2,
    "verl_config": {
        "algorithm": {
            "adv_estimator": "grpo",
            "use_kl_in_reward": false
        },
        "data": {
            "train_batch_size": 20,
            "max_prompt_length": 4096,
            "max_response_length": 2048,
            "truncation": "error"
        },
        "actor_rollout_ref": {
