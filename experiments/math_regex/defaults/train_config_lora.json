                    "param_offload": false,
                    "model_dtype": "bfloat16"
                }
            },
            "model": {
                "path": "Qwen/Qwen3-1.7B",
                "use_remove_padding": true,
                "enable_gradient_checkpointing": false,
                "lora_rank": 16,
                "lora_alpha": 32,
                "target_modules": "all-linear",
                "lora": {
                    "merge": true
                }
            }
        },
        "trainer": {
            "n_gpus_per_node": 1,
            "val_before_train": true,
            "critic_warmup": 0,
            "logger": [
                "console",
                "wandb"
            ],
            "project_name": "math_regex_dac",
            "experiment_name": "math_regex",
            "nnodes": 1,
            "test_freq": 32,
            "total_epochs": 10
